# Entorno de ejecución aceptado por server/config/env.ts: development | production | test (por defecto: development).
# NODE_ENV=development
# Puerto HTTP local (por defecto: 3000; el valor 8080 se normaliza a 3000 en server/config/env.ts).
# PORT=3000
# Duración del token JWT de acceso (por defecto: 7d).
# JWT_EXPIRES_IN=7d

# Cadena de conexión PostgreSQL de la aplicación (obligatoria cuando NODE_ENV=production).
# Escriba la URL local en su archivo .env sin versionar credenciales reales.
DATABASE_URL=

# Solo para pruebas reales contra PostgreSQL (atlob_test con rol no superusuario contabilidad_app).
TEST_DATABASE_URL=

# Secretos obligatorios en producción validados por server/config/env.ts:
# Cada variable requiere 32 bytes aleatorios independientes en 64 dígitos hexadecimales
# (>= 16 bytes distintos entre sí, sin reutilización ni valores históricos).
# En development/test, si se dejan vacíos, env.ts genera valores efímeros por proceso.
JWT_SECRET=
JWT_REFRESH_SECRET=
SUNAT_ENCRYPTION_KEY=
MFA_SEED_SECRET=
BACKUP_ENCRYPTION_KEY=
